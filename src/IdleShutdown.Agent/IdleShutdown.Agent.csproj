<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IdleShutdown.Agent</AssemblyName>
    <RootNamespace>IdleShutdown.AgentApp</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\idle-shutdown.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="..\IdleShutdown.Shared\PowerRequestPolicy.cs"
      Link="PowerRequestPolicy.cs" />
  </ItemGroup>
</Project>
